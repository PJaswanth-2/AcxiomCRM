@using AcxiomCRM.Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --sidebar-width: 250px;
            --topbar-height: 60px;
            --primary-color: #0f172a;
            --accent-color: #2563eb;
            --bg-color: #f8fafc;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: #334155;
            overflow-x: hidden;
        }

        /* Topbar */
        .topbar {
            height: var(--topbar-height);
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
        }

        .brand-logo {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary-color);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            width: var(--sidebar-width);
        }

        .brand-logo i {
            color: var(--accent-color);
            font-size: 1.5rem;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            position: fixed;
            top: var(--topbar-height);
            bottom: 0;
            left: 0;
            background-color: #0f172a;
            color: #94a3b8;
            padding-top: 1rem;
            z-index: 1020;
            transition: all 0.3s ease;
            overflow-y: auto;
        }

        .sidebar .nav-link {
            color: #94a3b8;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.05);
            border-left-color: var(--accent-color);
        }

        .sidebar .nav-header {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            padding: 1rem 1.5rem 0.5rem 1.5rem;
            font-weight: 700;
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: var(--topbar-height);
            padding: 2rem;
            min-height: calc(100vh - var(--topbar-height) - 60px);
        }

        /* Cards & UI elements */
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .badge-role-admin { background-color: #ef4444; color: #fff; }
        .badge-role-manager { background-color: #f59e0b; color: #fff; }
        .badge-role-sales { background-color: #3b82f6; color: #fff; }

        footer {
            margin-left: var(--sidebar-width);
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 1rem 2rem;
            color: #64748b;
            font-size: 0.875rem;
        }

        @@media (max-width: 991.98px) {
            .sidebar {
                left: -100%;
            }
            .sidebar.show {
                left: 0;
            }
            .main-content, footer {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Topbar Navigation -->
    <header class="topbar justify-content-between">
        <div class="d-flex align-items-center">
            <button class="btn btn-sm btn-light d-lg-none me-2" id="sidebarToggle">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="brand-logo" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-layers-half"></i> Acxiom<span class="text-primary">CRM</span>
            </a>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="userMenu" data-bs-toggle="dropdown">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px; font-weight: 600;">
                            @User.Identity.Name?[0].ToString().ToUpper()
                        </div>
                        <div class="d-none d-sm-block text-end me-2">
                            <div class="fw-semibold text-truncate" style="max-width: 150px;">@User.Identity.Name</div>
                            <span class="badge @(UserScopeHelper.IsAdmin(User) ? "badge-role-admin" : UserScopeHelper.IsManager(User) ? "badge-role-manager" : "badge-role-sales")" style="font-size: 0.65rem;">
                                @(UserScopeHelper.IsAdmin(User) ? "Admin" : UserScopeHelper.IsManager(User) ? "Manager" : "Sales Exec")
                            </span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                        <li><span class="dropdown-item-text text-muted small">Signed in as <strong>@User.Identity.Name</strong></span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Register</a>
            </div>
        }
    </header>

    <!-- Sidebar Navigation -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="sidebar" id="appSidebar">
            <div class="nav flex-column">
                <div class="nav-header">Main Menu</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i> Customers
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i> Leads
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                    <i class="bi bi-diagram-3"></i> Opportunities
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                    <i class="bi bi-calendar-check"></i> Follow-Ups
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                    <i class="bi bi-activity"></i> Activities
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart"></i> Reports
                </a>

                @if (UserScopeHelper.IsAdmin(User))
                {
                    <div class="nav-header">Administration</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-shield-lock"></i> User Management
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-person-badge"></i> Role Management
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Audit" ? "active" : "")" asp-controller="Audit" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Audit Logs
                    </a>
                }
            </div>
        </aside>
    }

    <!-- Main Content Area -->
    <main class="main-content" style="@(User.Identity?.IsAuthenticated == true ? "" : "margin-left: 0;")">
        <!-- Toast / Alerts Container -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer style="@(User.Identity?.IsAuthenticated == true ? "" : "margin-left: 0;")">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>&copy; @DateTime.Now.Year AcxiomCRM. All rights reserved. Enterprise CRM System.</div>
            <div>
                <a href="/swagger" target="_blank" class="text-decoration-none text-muted me-3"><i class="bi bi-code-square me-1"></i>REST API Docs</a>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#sidebarToggle').on('click', function () {
                $('#appSidebar').toggleClass('show');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
