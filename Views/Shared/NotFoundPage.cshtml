@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm p-5 mx-auto" style="max-width: 500px; border-radius: 1rem;">
        <div class="text-warning mb-3">
            <i class="bi bi-question-circle-fill" style="font-size: 3.5rem;"></i>
        </div>
        <h3 class="fw-bold mb-2">404 - Page Not Found</h3>
        <p class="text-muted mb-4">The page or resource you requested could not be found or has been moved.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i> Return to Dashboard</a>
    </div>
</div>
