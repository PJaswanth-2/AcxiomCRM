@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm p-5 mx-auto" style="max-width: 500px; border-radius: 1rem;">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-slash-fill" style="font-size: 3.5rem;"></i>
        </div>
        <h3 class="fw-bold mb-2 text-danger">403 - Access Denied</h3>
        <p class="text-muted mb-4">You do not have authorization to view this page or perform this action based on your role permissions.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i> Return to Dashboard</a>
    </div>
</div>
