@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "User Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-dark text-white text-center py-4 rounded-top-3">
                <h4 class="mb-1 fw-bold"><i class="bi bi-layers-half text-primary me-2"></i>AcxiomCRM</h4>
                <p class="text-white-50 small mb-0">Sign in to your corporate account</p>
            </div>
            <div class="card-body p-4 p-md-5">

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small alert alert-danger"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="username" />
                        <label asp-for="Email">Email Address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted">Remember this device</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-semibold shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                    </button>
                </form>

                <div class="border-top pt-3 text-center">
                    <p class="small text-muted mb-1">Don't have an account?</p>
                    <a asp-action="Register" class="text-decoration-none fw-semibold">Register New User Account</a>
                </div>
            </div>
        </div>

        <!-- Demo Accounts Box -->
        <div class="card bg-light border mt-4">
            <div class="card-body">
                <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-key-fill text-warning me-1"></i> Demo Evaluation Credentials:</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-borderless text-muted small mb-0">
                        <thead>
                            <tr class="border-bottom">
                                <th>Role</th>
                                <th>Email</th>
                                <th>Password</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge bg-danger">Admin</span></td>
                                <td><code>admin@acxiomcrm.com</code></td>
                                <td><code>Admin@123456</code></td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-warning text-dark">Manager</span></td>
                                <td><code>manager@acxiomcrm.com</code></td>
                                <td><code>Manager@123456</code></td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-primary">Sales Exec</span></td>
                                <td><code>sales@acxiomcrm.com</code></td>
                                <td><code>Sales@123456</code></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
