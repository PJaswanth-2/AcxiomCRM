@model AcxiomCRM.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Create User Account";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus text-danger me-2"></i>Create New User Account</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Sarah Jenkins" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address (Login Username) <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="sjenkins@acxiomcrm.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label fw-semibold">Assigned Primary Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select">
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="SalesExecutive">SalesExecutive</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" placeholder="Min 8 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Account Active</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold"><i class="bi bi-save me-1"></i> Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
