@model IEnumerable<AcxiomCRM.ViewModels.RoleItemViewModel>
@{
    ViewData["Title"] = "Role Management";
}

<div class="mb-4">
    <h3 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>Role Management</h3>
    <p class="text-muted small mb-0">Role definitions & user assignments within AcxiomCRM</p>
</div>

<div class="row g-4">
    @foreach (var role in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge @(role.RoleName == "Admin" ? "bg-danger fs-6" : role.RoleName == "Manager" ? "bg-warning text-dark fs-6" : "bg-primary fs-6")">
                            @role.RoleName
                        </span>
                        <span class="badge bg-light text-dark border">@role.UserCount Users</span>
                    </div>
                    <p class="text-muted small mb-0">
                        @if (role.RoleName == "Admin")
                        {
                            <span>Full application administration, user management, role governance, audit log inspection, and unrestricted CRM access.</span>
                        }
                        else if (role.RoleName == "Manager")
                        {
                            <span>Team CRM management, pipeline visibility, management reporting, and team customer/lead allocation.</span>
                        }
                        else
                        {
                            <span>Assigned customer accounts, leads, opportunities, follow-up scheduling, and personal sales dashboard.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
</div>
