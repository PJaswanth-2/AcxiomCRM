@model AcxiomCRM.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check text-success me-2"></i>Follow-Up Activities</h3>
        <p class="text-muted small mb-0">Schedule, track, complete, and reschedule client communications</p>
    </div>
    <a asp-action="Create" class="btn btn-success fw-semibold shadow-sm"><i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up</a>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search subject or related account..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Planned" selected="@(Model.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">-- All Types --</option>
                    <option value="Call" selected="@(Model.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.Type == "Email")">Email</option>
                    <option value="Task" selected="@(Model.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>Subject</th>
                        <th>Follow-Up Date</th>
                        <th>Type</th>
                        <th>Related Record</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.FollowUps.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No follow-ups found matching filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var fu in Model.FollowUps)
                        {
                            bool isOverdue = fu.Status == "Planned" && fu.FollowUpDate.Date < DateTime.Today;
                            <tr>
                                <td class="fw-semibold">
                                    @fu.Subject
                                    @if (!string.IsNullOrEmpty(fu.Notes))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 250px;">@fu.Notes</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(isOverdue ? "bg-danger" : "bg-light text-dark border")">
                                        <i class="bi bi-clock me-1"></i>@fu.FollowUpDate.ToString("MMM dd, yyyy")
                                    </span>
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">OVERDUE</span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@fu.FollowUpType</span></td>
                                <td class="small">
                                    @(fu.Customer != null ? $"Customer: {fu.Customer.CustomerName}" : fu.Lead != null ? $"Lead: {fu.Lead.LeadName}" : fu.Opportunity != null ? $"Opp: {fu.Opportunity.OpportunityName}" : "-")
                                </td>
                                <td><span class="badge bg-light text-dark border">@(fu.AssignedUser?.Name ?? "Unassigned")</span></td>
                                <td>
                                    <span class="badge @(fu.Status == "Completed" ? "bg-success" : fu.Status == "Planned" ? "bg-primary" : fu.Status == "Missed" ? "bg-danger" : "bg-secondary")">@fu.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (fu.Status == "Planned")
                                        {
                                            <form asp-action="Complete" asp-route-id="@fu.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" title="Mark Complete"><i class="bi bi-check-lg"></i> Complete</button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@fu.FollowUpId" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @Model.Page of @Model.TotalPages (@Model.TotalCount follow-ups)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-status="@Model.Status">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
