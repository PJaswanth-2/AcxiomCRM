@model AcxiomCRM.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-info me-2"></i>Sales Leads</h3>
        <p class="text-muted small mb-0">Capture, track, qualify, and convert prospective client leads</p>
    </div>
    <a asp-action="Create" class="btn btn-info text-white fw-semibold shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add New Lead</a>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search lead name, email, phone, company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="New" selected="@(Model.Status == "New")">New</option>
                    <option value="Contacted" selected="@(Model.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.Status == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(Model.Status == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(Model.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="priority" class="form-select">
                    <option value="">-- All Priorities --</option>
                    <option value="High" selected="@(Model.Priority == "High")">High Priority</option>
                    <option value="Medium" selected="@(Model.Priority == "Medium")">Medium Priority</option>
                    <option value="Low" selected="@(Model.Priority == "Low")">Low Priority</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Contact</th>
                        <th>Source</th>
                        <th>Expected Value</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Leads.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No leads found matching specified filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lead in Model.Leads)
                        {
                            <tr>
                                <td><code>@lead.LeadCode</code></td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@lead.LeadId" class="text-decoration-none text-dark">@lead.LeadName</a>
                                    @if (!string.IsNullOrEmpty(lead.CompanyName))
                                    {
                                        <div class="small text-muted">@lead.CompanyName</div>
                                    }
                                </td>
                                <td class="small">
                                    <div>@lead.Email</div>
                                    <div class="text-muted">@lead.Phone</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@lead.Source</span></td>
                                <td class="fw-bold text-success">$@lead.ExpectedValue.ToString("N0")</td>
                                <td>
                                    <span class="badge @(lead.Priority == "High" ? "bg-danger" : lead.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">@lead.Priority</span>
                                </td>
                                <td>
                                    <span class="badge @(lead.Status == "Converted" ? "bg-success" : lead.Status == "Qualified" ? "bg-info text-dark" : lead.Status == "New" ? "bg-primary" : lead.Status == "Lost" ? "bg-danger" : "bg-secondary")">@lead.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (lead.Status == "Qualified" || lead.Status == "New" || lead.Status == "Contacted")
                                        {
                                            <a asp-action="Convert" asp-route-id="@lead.LeadId" class="btn btn-success" title="Convert Lead"><i class="bi bi-arrow-right-circle"></i> Convert</a>
                                        }
                                        <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-primary"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total leads)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
