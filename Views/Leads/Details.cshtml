@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Details";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-badge text-info me-2"></i>@Model.LeadName</h3>
        <p class="text-muted small mb-0">Lead Code: <code>@Model.LeadCode</code> | Status: <span class="badge @(Model.Status == "Converted" ? "bg-success" : Model.Status == "Qualified" ? "bg-info text-dark" : "bg-primary")">@Model.Status</span></p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success fw-semibold"><i class="bi bi-arrow-right-circle me-1"></i> Convert to Customer</a>
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Edit Lead</a>
        }
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold py-3 border-bottom">
                <i class="bi bi-info-circle text-info me-2"></i>Lead Specification
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Company:</dt>
                    <dd class="col-sm-8 fw-semibold">@(string.IsNullOrEmpty(Model.CompanyName) ? "-" : Model.CompanyName)</dd>

                    <dt class="col-sm-4 text-muted">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Phone:</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted">Lead Source:</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@Model.Source</span></dd>

                    <dt class="col-sm-4 text-muted">Priority:</dt>
                    <dd class="col-sm-8"><span class="badge @(Model.Priority == "High" ? "bg-danger" : "bg-warning text-dark")">@Model.Priority</span></dd>

                    <dt class="col-sm-4 text-muted">Expected Value:</dt>
                    <dd class="col-sm-8 fw-bold text-success">$@Model.ExpectedValue.ToString("N0")</dd>

                    <dt class="col-sm-4 text-muted">Assigned Exec:</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.AssignedTo?.Name ?? "Unassigned")</span></dd>

                    <dt class="col-sm-4 text-muted">Created Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                    @if (Model.ConvertedCustomer != null)
                    {
                        <dt class="col-sm-4 text-muted">Converted Client:</dt>
                        <dd class="col-sm-8"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="fw-bold text-success">@Model.ConvertedCustomer.CustomerName (@Model.ConvertedCustomer.CustomerCode)</a></dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold py-3 border-bottom">
                <i class="bi bi-chat-left-text text-secondary me-2"></i>Notes & Activities
            </div>
            <div class="card-body">
                <p class="text-muted small">@Model.Notes</p>

                <h6 class="fw-bold mt-4 mb-2">Planned Follow-Ups</h6>
                <ul class="list-group list-group-flush mb-0">
                    @if (!Model.FollowUps.Any())
                    {
                        <li class="list-group-item text-muted small px-0">No follow-ups recorded for this lead.</li>
                    }
                    else
                    {
                        @foreach (var fu in Model.FollowUps)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@fu.Subject</div>
                                    <div class="small text-muted">@fu.FollowUpDate.ToString("MMM dd, yyyy") | @fu.FollowUpType</div>
                                </div>
                                <span class="badge bg-secondary">@fu.Status</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
