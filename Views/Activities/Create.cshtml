@model AcxiomCRM.ViewModels.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle text-secondary me-2"></i>Log New Sales Activity</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 alert alert-danger small"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject / Title <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discovery call with CTO" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="ActivityType" class="form-label fw-semibold">Activity Type</label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityDate" class="form-label fw-semibold">Date & Time</label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Planned">Planned</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Related Customer</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersSelectList" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold">Related Lead</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsSelectList" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="OpportunityId" class="form-label fw-semibold">Related Opportunity</label>
                            <select asp-for="OpportunityId" asp-items="Model.OpportunitiesSelectList" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedToUserId" class="form-label fw-semibold">Assigned User</label>
                        <select asp-for="AssignedToUserId" asp-items="Model.UsersSelectList" class="form-select">
                            <option value="">-- Assign to Me / Unassigned --</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Description & Outcome</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Summary of discussion, action items, customer feedback..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-secondary px-4 fw-semibold"><i class="bi bi-save me-1"></i> Log Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
