@model AcxiomCRM.ViewModels.OpportunityListViewModel
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-warning me-2"></i>Sales Opportunities</h3>
        <p class="text-muted small mb-0">Track deal pipeline, amounts, stages, probabilities, and expected close dates</p>
    </div>
    <a asp-action="Create" class="btn btn-warning text-dark fw-semibold shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add New Opportunity</a>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search opportunity name or client..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">-- All Stages --</option>
                    <option value="Qualification" selected="@(Model.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(Model.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(Model.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(Model.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Open" selected="@(Model.Status == "Open")">Open Deals</option>
                    <option value="Won" selected="@(Model.Status == "Won")">Won Deals</option>
                    <option value="Lost" selected="@(Model.Status == "Lost")">Lost Deals</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Account / Client</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Prob (%)</th>
                        <th>Weighted Pipeline</th>
                        <th>Close Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Opportunities.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No opportunities found matching criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none text-dark">@opp.OpportunityName</a>
                                </td>
                                <td>
                                    @(opp.Customer != null ? opp.Customer.CustomerName : opp.Lead != null ? opp.Lead.LeadName : "-")
                                </td>
                                <td class="fw-bold text-success">$@opp.Amount.ToString("N0")</td>
                                <td>
                                    <span class="badge @(opp.Stage == "Won" ? "bg-success" : opp.Stage == "Lost" ? "bg-danger" : opp.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary")">@opp.Stage</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 50px;">
                                            <div class="progress-bar @(opp.Probability >= 75 ? "bg-success" : opp.Probability >= 40 ? "bg-warning" : "bg-info")" style="width: @opp.Probability%;"></div>
                                        </div>
                                        <span class="small font-monospace">@opp.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-muted">$@opp.WeightedPipeline.ToString("N0")</td>
                                <td class="small">
                                    <span class="@(opp.Status == "Open" && opp.ExpectedCloseDate.Date < DateTime.Today ? "text-danger fw-bold" : "")">
                                        @opp.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-outline-primary"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @Model.Page of @Model.TotalPages (@Model.TotalCount opportunities)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
