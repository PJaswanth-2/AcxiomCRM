@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-warning me-2"></i>@Model.OpportunityName</h3>
        <p class="text-muted small mb-0">Stage: <span class="badge bg-warning text-dark">@Model.Stage</span> | Status: <span class="badge @(Model.Status == "Won" ? "bg-success" : Model.Status == "Lost" ? "bg-danger" : "bg-primary")">@Model.Status</span></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i> Edit Opportunity</a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-info text-white"><i class="bi bi-calendar-plus me-1"></i> Schedule Follow-up</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold py-3 border-bottom">
                <i class="bi bi-cash-stack text-success me-2"></i>Financial & Deal Metrics
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Total Amount:</dt>
                    <dd class="col-sm-8 fw-bold fs-5 text-success">$@Model.Amount.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Win Probability:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Probability%</dd>

                    <dt class="col-sm-4 text-muted">Weighted Pipeline:</dt>
                    <dd class="col-sm-8 fw-bold text-primary">$@Model.WeightedPipeline.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Expected Close Date:</dt>
                    <dd class="col-sm-8">@Model.ExpectedCloseDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Linked Customer:</dt>
                    <dd class="col-sm-8">
                        @(Model.Customer != null ? Html.Raw($"<a href='/Customers/Details/{Model.CustomerId}' class='fw-semibold text-decoration-none'>{Model.Customer.CustomerName}</a>") : "-")
                    </dd>

                    <dt class="col-sm-4 text-muted">Assigned Exec:</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.AssignedTo?.Name ?? "Unassigned")</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold py-3 border-bottom">
                <i class="bi bi-file-text text-secondary me-2"></i>Strategy & Notes
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded for this opportunity." : Model.Notes)</p>

                <h6 class="fw-bold border-top pt-3 mb-2">Linked Follow-Ups</h6>
                <ul class="list-group list-group-flush mb-0">
                    @if (!Model.FollowUps.Any())
                    {
                        <li class="list-group-item text-muted small px-0">No follow-ups recorded.</li>
                    }
                    else
                    {
                        @foreach (var fu in Model.FollowUps)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@fu.Subject</div>
                                    <div class="small text-muted">@fu.FollowUpDate.ToString("MMM dd, yyyy") | @fu.FollowUpType</div>
                                </div>
                                <span class="badge bg-secondary">@fu.Status</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
