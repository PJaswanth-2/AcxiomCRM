@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Customer Master Report</h3>
        <p class="text-muted small mb-0">Filtered client accounts and assigned executive summary</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-reportType="customer" class="btn btn-primary fw-semibold"><i class="bi bi-download me-1"></i> Export CSV</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>City / State</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><code>@c.CustomerCode</code></td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@(string.IsNullOrEmpty(c.CompanyName) ? "-" : c.CompanyName)</td>
                            <td>@c.City, @c.State</td>
                            <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                            <td><span class="badge bg-light text-dark border">@(c.AssignedTo?.Name ?? "Unassigned")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
