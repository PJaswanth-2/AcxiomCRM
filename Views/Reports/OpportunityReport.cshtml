@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-warning me-2"></i>Sales Opportunity Report</h3>
        <p class="text-muted small mb-0">Detailed breakdown of deals, amounts, probabilities, and close dates</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-reportType="opportunity" class="btn btn-warning text-dark fw-semibold"><i class="bi bi-download me-1"></i> Export CSV</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Client</th>
                        <th>Amount ($)</th>
                        <th>Stage</th>
                        <th>Prob (%)</th>
                        <th>Weighted Value ($)</th>
                        <th>Close Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@o.OpportunityName</td>
                            <td>@(o.Customer?.CustomerName ?? "-")</td>
                            <td class="fw-bold text-success">$@o.Amount.ToString("N0")</td>
                            <td><span class="badge bg-warning text-dark">@o.Stage</span></td>
                            <td>@o.Probability%</td>
                            <td class="fw-semibold text-muted">$@o.WeightedPipeline.ToString("N0")</td>
                            <td class="small">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge @(o.Status == "Won" ? "bg-success" : o.Status == "Lost" ? "bg-danger" : "bg-primary")">@o.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
