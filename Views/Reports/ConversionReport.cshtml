@model dynamic
@{
    ViewData["Title"] = "Lead Conversion Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-arrow-repeat text-primary me-2"></i>Lead Conversion Analytics</h3>
        <p class="text-muted small mb-0">Sales funnel efficiency & conversion rates from prospective leads to active clients</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary text-white p-3 text-center">
            <div class="fs-6 text-white-50">Total Leads</div>
            <h2 class="fw-bold my-1">@Model.TotalLeads</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success text-white p-3 text-center">
            <div class="fs-6 text-white-50">Converted Leads</div>
            <h2 class="fw-bold my-1">@Model.ConvertedLeads</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-info text-dark p-3 text-center">
            <div class="fs-6 text-dark text-opacity-75">Qualified Leads</div>
            <h2 class="fw-bold my-1">@Model.QualifiedLeads</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-dark text-white p-3 text-center">
            <div class="fs-6 text-white-50">Conversion Rate</div>
            <h2 class="fw-bold my-1 text-warning">@Model.ConversionRatePercent%</h2>
        </div>
    </div>
</div>
