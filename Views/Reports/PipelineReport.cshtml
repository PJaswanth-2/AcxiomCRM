@model IEnumerable<AcxiomCRM.DTOs.PipelineReportDto>
@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-funnel text-success me-2"></i>Sales Pipeline Report</h3>
        <p class="text-muted small mb-0">Stage-wise opportunity count, total value, and weighted pipeline forecasting</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-reportType="pipeline" class="btn btn-success fw-semibold"><i class="bi bi-download me-1"></i> Export CSV</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Hub</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>Pipeline Stage</th>
                        <th>Opportunity Count</th>
                        <th>Total Amount ($)</th>
                        <th>Weighted Amount ($)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <span class="badge @(item.Stage == "Won" ? "bg-success" : item.Stage == "Lost" ? "bg-danger" : item.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary") fs-6">
                                    @item.Stage
                                </span>
                            </td>
                            <td class="fw-semibold fs-6">@item.OpportunityCount</td>
                            <td class="fw-bold text-success fs-6">$@item.TotalAmount.ToString("N2")</td>
                            <td class="fw-bold text-primary fs-6">$@item.WeightedAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-dark">
                    <tr>
                        <th>Total Pipeline Summary</th>
                        <th>@Model.Sum(m => m.OpportunityCount)</th>
                        <th>$@Model.Sum(m => m.TotalAmount).ToString("N2")</th>
                        <th>$@Model.Sum(m => m.WeightedAmount).ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
