@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-info me-2"></i>Lead Acquisition Report</h3>
        <p class="text-muted small mb-0">Lead sources, status distribution, and expected deal values</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-reportType="lead" class="btn btn-info text-white fw-semibold"><i class="bi bi-download me-1"></i> Export CSV</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Contact</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td><code>@l.LeadCode</code></td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td class="small">@l.Email | @l.Phone</td>
                            <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                            <td><span class="badge @(l.Status == "Converted" ? "bg-success" : l.Status == "Qualified" ? "bg-info text-dark" : "bg-primary")">@l.Status</span></td>
                            <td><span class="badge bg-secondary">@l.Priority</span></td>
                            <td class="fw-bold text-success">$@l.ExpectedValue.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
