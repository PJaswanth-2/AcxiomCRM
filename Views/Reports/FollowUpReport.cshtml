@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check text-secondary me-2"></i>Follow-Up Activity Report</h3>
        <p class="text-muted small mb-0">Summary of planned, completed, missed, and overdue activities</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Follow-Up Date</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Assigned User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@f.Subject</td>
                            <td>@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                            <td><span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-danger")">@f.Status</span></td>
                            <td>@(f.AssignedUser?.Name ?? "Unassigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
